vec4 shockFront(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*192.0;
    int left = int(arc)*5, right = ((int(arc)+1)%192)*5;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(shockFrontAmplitudes[left]),rimUnpack(shockFrontAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<5; term+=2) {
        edges += wave.x*mix(rimUnpack(shockFrontAmplitudes[left+term]),rimUnpack(shockFrontAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(shockFrontAmplitudes[left+term+1]),rimUnpack(shockFrontAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(0.0937909,0.0130549,0.0766864,0.1437138) + edges*vec4(0.0124560,0.0117375,0.0068386,0.0237051);
}

