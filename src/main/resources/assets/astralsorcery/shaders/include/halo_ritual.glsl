vec4 ritualShoulders(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*96.0;
    int left = int(arc)*15, right = ((int(arc)+1)%96)*15;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(ritualShouldersAmplitudes[left]),rimUnpack(ritualShouldersAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<15; term+=2) {
        edges += wave.x*mix(rimUnpack(ritualShouldersAmplitudes[left+term]),rimUnpack(ritualShouldersAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(ritualShouldersAmplitudes[left+term+1]),rimUnpack(ritualShouldersAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(0.4166276,0.6380063,0.4955186,0.5615313) + edges*vec4(0.0002188,0.0002768,0.0001547,0.0001455);
}

