vec4 ritualLight(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*96.0;
    int left = int(arc)*15, right = ((int(arc)+1)%96)*15;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(ritualLightAmplitudes[left]),rimUnpack(ritualLightAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<15; term+=2) {
        edges += wave.x*mix(rimUnpack(ritualLightAmplitudes[left+term]),rimUnpack(ritualLightAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(ritualLightAmplitudes[left+term+1]),rimUnpack(ritualLightAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(-0.0161036,-0.1385431,0.0509889,-0.0295080) + edges*vec4(0.0011124,0.0008606,0.0007861,0.0010996);
}
