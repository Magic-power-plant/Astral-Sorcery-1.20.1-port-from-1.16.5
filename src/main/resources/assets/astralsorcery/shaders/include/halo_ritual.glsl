vec4 ritualRims(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*128.0;
    int left = int(arc)*23, right = ((int(arc)+1)%128)*23;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(ritualRimsAmplitudes[left]),rimUnpack(ritualRimsAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<23; term+=2) {
        edges += wave.x*mix(rimUnpack(ritualRimsAmplitudes[left+term]),rimUnpack(ritualRimsAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(ritualRimsAmplitudes[left+term+1]),rimUnpack(ritualRimsAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(0.3524170,0.7020882,0.4724027,0.5841148) + edges*vec4(0.0003091,0.0003770,0.0001360,0.0001617);
}

