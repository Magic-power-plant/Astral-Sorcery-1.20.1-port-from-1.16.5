vec4 dazzlingRims(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*256.0;
    int left = int(arc)*11, right = ((int(arc)+1)%256)*11;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(dazzlingRimsAmplitudes[left]),rimUnpack(dazzlingRimsAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<11; term+=2) {
        edges += wave.x*mix(rimUnpack(dazzlingRimsAmplitudes[left+term]),rimUnpack(dazzlingRimsAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(dazzlingRimsAmplitudes[left+term+1]),rimUnpack(dazzlingRimsAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(0.5392177,0.8480503,0.5917086,0.7978110) + edges*vec4(0.0002833,0.0004051,0.0004124,0.0005216);
}
