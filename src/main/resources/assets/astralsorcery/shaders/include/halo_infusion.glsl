vec4 infusionBlue(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*64.0;
    int left = int(arc)*9, right = ((int(arc)+1)%64)*9;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(infusionBlueAmplitudes[left]),rimUnpack(infusionBlueAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<9; term+=2) {
        edges += wave.x*mix(rimUnpack(infusionBlueAmplitudes[left+term]),rimUnpack(infusionBlueAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(infusionBlueAmplitudes[left+term+1]),rimUnpack(infusionBlueAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(0.0020201,0.0243171,-0.0096554,0.0433037) + edges*vec4(0.0007661,0.0007787,0.0002944,0.0015166);
}
