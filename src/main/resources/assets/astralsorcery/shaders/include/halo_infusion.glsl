vec4 infusionGreen(float azimuth, vec2 clock) {
    float arc = fract(azimuth)*96.0;
    int left = int(arc)*11, right = ((int(arc)+1)%96)*11;
    float blend = fract(arc);
    vec4 edges = mix(rimUnpack(infusionGreenAmplitudes[left]),rimUnpack(infusionGreenAmplitudes[right]),blend);
    vec2 wave = clock;
    for (int term=1; term<11; term+=2) {
        edges += wave.x*mix(rimUnpack(infusionGreenAmplitudes[left+term]),rimUnpack(infusionGreenAmplitudes[right+term]),blend);
        edges += wave.y*mix(rimUnpack(infusionGreenAmplitudes[left+term+1]),rimUnpack(infusionGreenAmplitudes[right+term+1]),blend);
        wave = vec2(wave.x*clock.x-wave.y*clock.y,wave.y*clock.x+wave.x*clock.y);
    }
    return vec4(0.0587632,0.0750681,-0.1350343,-0.0533762) + edges*vec4(0.0017749,0.0018374,0.0010213,0.0012376);
}

