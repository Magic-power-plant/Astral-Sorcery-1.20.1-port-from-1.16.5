vec4 shockMaterial(vec2 position, float tick) {
    if (tick >= 42.0) return vec4(0);
    float front = -.08632+.01125*tick+.28109*(1.0-exp(-.12821*tick));
    float angle = atan(position.y,position.x+1e-10);
    vec4 shock = craft_burstMaterial(length(position)-front,angle,direction(tick*TAU/84.0),0);
    if (tick>40.0) {
        float across = mod(degrees(angle)-297.75+180.0,360.0)-180.0;
        float jet = 1.74*exp(-pow(abs(across)/2.1,2.0));
        float wave = .26*cos(2.0*angle+2.04)+.19*cos(9.0*angle-2.24)+.13*cos(26.0*angle+.91);
        float breadth = .06224+.10316*exp(-.16759*tick);
        float energy = .0626*pow(max(0.0,41.60-tick),1.12)*(1.0+wave+jet)
                     *exp(-pow(abs(length(position)-front)/breadth,2.2983));
        shock = mix(shock,vec4(.92,.92,.97,energy),smoothstep(40.0,41.0,tick));
    }
    return shock;
}
